<UserControl x:Class="AmbientWeatherDashboard.Controls.WeatherCard" x:Name="Card"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Grid>
    <Border Background="#29000510" CornerRadius="23" Margin="0,3,-1,-3" IsHitTestVisible="False"/>
    <Border BorderThickness="1" CornerRadius="23">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
          <Setter Property="Background" Value="{StaticResource CardBackground}"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="#6588A1"/>
              <Setter Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0.62" EndPoint="1,0">
                    <GradientStop Color="#0D2138" Offset="0"/>
                    <GradientStop Color="#0D2C46" Offset="1"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="49"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" ToolTip="{Binding Detail, ElementName=Card}">
          <DockPanel Margin="20,0,13,0">
            <Path DockPanel.Dock="Left" Data="{Binding Glyph, ElementName=Card}" Width="22" Height="22"
              Stretch="Uniform" Stroke="{StaticResource Blue}" StrokeThickness="1.45" StrokeLineJoin="Round"
              Margin="0,0,13,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="•••" Padding="7,4" VerticalAlignment="Center"
              Foreground="{StaticResource Blue}" BorderBrush="Transparent" Background="Transparent"
              Style="{StaticResource MinorButton}" Click="OpenMenu"
              AutomationProperties.Name="{Binding Title, ElementName=Card}" AutomationProperties.HelpText="{Binding Text.Details}">
              <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="{Binding Text.Refresh}" Command="{Binding RefreshCommand}"/>
                  <MenuItem Header="{Binding Text.Details}" Click="ShowDetails"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <TextBlock Text="{Binding Title, ElementName=Card}" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ContentPresenter Grid.Row="1" Content="{Binding Body, ElementName=Card}" Margin="16,10,16,12"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
