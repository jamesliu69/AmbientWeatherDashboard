<UserControl x:Class="AmbientWeatherDashboard.Views.SunCycleCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:AmbientWeatherDashboard.Controls"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <controls:WeatherCard Title="{Binding Text.SunCycleTitle, FallbackValue='SUN CYCLE'}" Glyph="M3,17 H21 M5,14 H19 M7,12 A5,5 0 0 1 17,12 M12,3 V5 M4,6 L6,8 M20,6 L18,8"
    Animate="{Binding Motion}" Detail="{Binding Text.SunCycleTip}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <controls:SunCycleControl Margin="0,8,0,10" StartAngle="{Binding SunStart}" DaySweep="{Binding SunSweep}" d:StartAngle="270" d:DaySweep="180" d:Value="0.75" d:Duration="12 hr 0 min"
        ChineseLabels="{Binding Text.IsChinese}" Value="{Binding SunProgress}" Duration="{Binding Daylight, FallbackValue=—}" Animate="{Binding Motion}"
        AutomationProperties.Name="{Binding Daylight}"/>
      <Grid Grid.Row="1" Margin="8,1,8,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Text.Sunrise}" Style="{StaticResource Caption}" Margin="15,0,0,4"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding Sunrise}" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Text.Sunset}" Style="{StaticResource Caption}" Margin="15,0,0,4"/>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Blue}" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding Sunset}" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </controls:WeatherCard>
</UserControl>
