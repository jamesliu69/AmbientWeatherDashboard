<UserControl x:Class="AmbientWeatherDashboard.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:AmbientWeatherDashboard.ViewModels"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Border MaxWidth="620" Padding="32" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="23">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding Text.CitySearch}" FontSize="29" FontWeight="SemiBold"/>
      <Label Grid.Row="1" Content="{Binding Text.CityQuery}" Target="{Binding ElementName=Query}"
        Padding="0" Margin="0,18,0,8" Foreground="{StaticResource SecondaryText}"/>
      <DockPanel Grid.Row="2">
        <Button DockPanel.Dock="Right" Content="{Binding Text.Search}" Command="{Binding Home.SearchCommand}"
          Style="{StaticResource MinorButton}" Margin="10,0,0,0" IsDefault="True"/>
        <TextBox x:Name="Query" Text="{Binding Home.Query, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxLength="100"
          Background="#102E49" Foreground="{StaticResource PrimaryText}" CaretBrush="{StaticResource PrimaryText}"
          BorderBrush="{StaticResource Divider}"/>
      </DockPanel>
      <TextBlock Grid.Row="3" Text="{Binding Home.SearchStatus}" ToolTip="{Binding Home.SearchError}"
        Style="{StaticResource Caption}" Margin="0,7"/>
      <ListBox Grid.Row="4" ItemsSource="{Binding Home.Results}" SelectedItem="{Binding Home.SelectedLocation}" DisplayMemberPath="Label"
        Background="#10283F" Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource Divider}"
        Height="155" AutomationProperties.Name="{Binding Text.CitySearch}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="#1C405B"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="#285875"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Blue}"/>
                      <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
      <StackPanel Grid.Row="5" Margin="0,18,0,0">
        <TextBlock Text="{Binding Dashboard.City}" Style="{StaticResource Caption}" Margin="0,0,0,10"
          AutomationProperties.Name="{Binding Text.CurrentCity}"/>
        <WrapPanel>
          <Button Content="{Binding Text.UseCity}" Command="{Binding SelectLocationCommand}" CommandParameter="{Binding Home.SelectedLocation}"
            Style="{StaticResource MinorButton}" Margin="0,0,10,0"/>
          <Button Content="{Binding Text.Dashboard}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Dashboard}"
            Style="{StaticResource MinorButton}"/>
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
