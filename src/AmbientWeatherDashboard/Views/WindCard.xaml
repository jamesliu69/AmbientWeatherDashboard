<UserControl x:Class="AmbientWeatherDashboard.Views.WindCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:AmbientWeatherDashboard.Controls"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <controls:WeatherCard Title="{Binding Text.WindTitle, FallbackValue='WIND'}" Glyph="M3,9 H15 A3,3 0 1 0 12,6 M2,13 H19 A2.5,2.5 0 1 1 16.5,15.5 M4,17 H10 A2.5,2.5 0 1 1 7.5,19.5"
    Animate="{Binding Motion}" Detail="{Binding Text.WindTip}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <controls:WindCompassControl Value="{Binding WindDirection}" Speed="{Binding WindSpeed, FallbackValue=—}"
        d:Value="85" d:Speed="12.4" Unit="{Binding WindUnit, FallbackValue=KM/H}" Animate="{Binding Motion}"
        AutomationProperties.Name="{Binding WindAccessible}" Margin="2,0,2,5"/>
      <Grid Grid.Row="1" Margin="9,0,9,7">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Text.WindNow}" Style="{StaticResource Caption}" FontSize="12"/>
          <TextBlock Text="{Binding WindWithUnit}" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Text.Gust}" Style="{StaticResource Caption}" FontSize="12" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding Gust}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Grid>
  </controls:WeatherCard>
</UserControl>
